{
  "description": "Faz as leis do dono valerem: injeta as leis no início, registra a correção do dono, confere a resposta final e as ações de risco. Modo padrão: observar.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/sessao.mjs\"", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/relato.mjs\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/fiscal-resposta.mjs\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|AskUserQuestion", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/fiscal-acao.mjs\"", "timeout": 10 }] }
    ]
  }
}
